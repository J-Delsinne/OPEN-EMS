+{#
+  Story 11.3 — Homeowner Credentials section partial.
+
+  Renders one of two variants based on ``section.homeowner``:
+    - homeowner is None → create form
+    - homeowner is set  → read-only display + reset trigger (inline form
+                          loads into #homeowner-reset-slot on click)
+
+  HTMX targets:
+    - POST /actions/create-homeowner → outerHTML swap of this entire section
+    - POST /actions/reset-homeowner-password → outerHTML swap of this section
+    - GET /fragments/installer/homeowner-reset-form → outerHTML swap of
+      the #homeowner-reset-slot element only
+#}
+<section
+  id="homeowner-credentials-section"
+  class="installer-settings-section"
+  aria-label="Homeowner credentials"
+>
+  <h2>Homeowner credentials</h2>
+
+  {% if section.banner_message %}
+  <p
+    class="installer-settings-banner installer-settings-banner--{{ section.banner_kind or 'info' }}"
+    role="status"
+  >{{ section.banner_message }}
+    <a href="/installer/event-log?type=SYSTEM&window=24h">View in event log →</a>
+  </p>
+  {% endif %}
+
