+
+    expires_at = _parse_expires_at(str(session_row["expires_at"]))
+    if expires_at is None or datetime.now(UTC) >= expires_at:
+        return None
+
+    user_row = await UserRepo().get_by_id(str(session_row["user_id"]))
+    if user_row is None:
+        return None
+
+    return user_row, session_row
