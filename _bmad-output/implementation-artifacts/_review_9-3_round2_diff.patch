+      id="battery_reserve_floor_percent"
+      name="battery_reserve_floor_percent"
+      type="number"
+      min="0"
+      max="100"
+      step="0.1"
+      required
+      value="{% if view.raw_battery_reserve_floor_percent_text is not none %}{{ view.raw_battery_reserve_floor_percent_text }}{% else %}{{ '%.1f' % view.battery_reserve_floor_percent }}{% endif %}"
