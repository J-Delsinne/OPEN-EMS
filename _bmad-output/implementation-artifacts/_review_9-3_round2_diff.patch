+    repo_with_conn: tuple[DraftConstraintsRepo, aiosqlite.Connection],
+) -> None:
+    repo, _ = repo_with_conn
+    assert await repo.get("session-x") is None
+
+
+async def test_upsert_inserts_with_pending_status_and_no_report(
+    repo_with_conn: tuple[DraftConstraintsRepo, aiosqlite.Connection],
+) -> None:
