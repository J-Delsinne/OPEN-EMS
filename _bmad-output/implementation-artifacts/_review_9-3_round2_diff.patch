+def _make_input(peak: float, floor: float):
+    from open_ems.core.constraints import ActiveConstraintsInput
+
+    return ActiveConstraintsInput(
+        peak_limit_kw=peak,
+        battery_reserve_floor_percent=floor,
+    )
