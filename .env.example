# OPEN-EMS environment configuration
# Copy to .env and fill in values before running the service.
# This file is committed to version control. .env is NOT committed.
#
# All settings will be documented here as they are introduced in later stories.
# See Story 1.7 for the full pydantic-settings configuration schema.

# Web server port (default: 8443)
# PORT=8443

# SQLite database file path (default: open_ems.db)
# DB_PATH=open_ems.db

# Application secret for session signing — REQUIRED in future stories (Story 1.7)
# SECRET_KEY=<generate with: openssl rand -hex 32>

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO

# NTP server for clock drift detection (optional; default: disabled)
# NTP_HOST=pool.ntp.org

# TLS certificate paths — generated by: bash scripts/generate-tls.sh
# For native install (relative to project root):
# TLS_CERT_PATH=certs/cert.pem
# TLS_KEY_PATH=certs/key.pem
# Note: Docker Compose sets these to /app/certs/cert.pem and /app/certs/key.pem via environment block
